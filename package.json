{
  "name": "rspack-plugin-svg-sprite",
  "version": "1.5.3",
  "description": "SVG sprite loader and plugin for Rspack — drop-in replacement for svg-sprite-loader with inline and extract mode support",
  "author": "Yichen Zhu",
  "license": "MIT",
  "type": "commonjs",
  "homepage": "https://github.com/yichenzhu1337/rspack-plugin-svg-sprite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yichenzhu1337/rspack-plugin-svg-sprite.git"
  },
  "bugs": {
    "url": "https://github.com/yichenzhu1337/rspack-plugin-svg-sprite/issues"
  },
  "keywords": [
    "rspack",
    "rspack-plugin",
    "rspack-loader",
    "rsbuild",
    "rsbuild-plugin",
    "svg",
    "svg-sprite",
    "svg-sprite-loader",
    "svg-icon",
    "svg-icons",
    "sprite",
    "sprite-sheet",
    "icon",
    "icon-system",
    "loader",
    "plugin",
    "bundler-plugin",
    "webpack",
    "webpack5",
    "extract",
    "inline",
    "symbol",
    "react",
    "vue",
    "migration",
    "drop-in"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin.d.mts",
        "default": "./dist/plugin.mjs"
      },
      "default": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.js"
      }
    },
    "./loader": {
      "import": {
        "types": "./dist/loader.d.mts",
        "default": "./dist/loader.mjs"
      },
      "default": {
        "types": "./dist/loader.d.ts",
        "default": "./dist/loader.js"
      }
    },
    "./runtime/browser-sprite": {
      "import": {
        "types": "./dist/runtime/browser-sprite.d.mts",
        "default": "./dist/runtime/browser-sprite.mjs"
      },
      "default": {
        "types": "./dist/runtime/browser-sprite.d.ts",
        "default": "./dist/runtime/browser-sprite.js"
      }
    },
    "./runtime/symbol": {
      "import": {
        "types": "./dist/runtime/symbol.d.mts",
        "default": "./dist/runtime/symbol.mjs"
      },
      "default": {
        "types": "./dist/runtime/symbol.d.ts",
        "default": "./dist/runtime/symbol.js"
      }
    },
    "./rsbuild": {
      "import": {
        "types": "./dist/rsbuild.d.mts",
        "default": "./dist/rsbuild.mjs"
      },
      "default": {
        "types": "./dist/rsbuild.d.ts",
        "default": "./dist/rsbuild.js"
      }
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "plugin": [
        "./dist/plugin.d.ts"
      ],
      "loader": [
        "./dist/loader.d.ts"
      ],
      "runtime/browser-sprite": [
        "./dist/runtime/browser-sprite.d.ts"
      ],
      "runtime/symbol": [
        "./dist/runtime/symbol.d.ts"
      ],
      "rsbuild": [
        "./dist/rsbuild.d.ts"
      ],
      "client": [
        "./client.d.ts"
      ]
    }
  },
  "files": [
    "dist/",
    "client.d.ts",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && rstest run",
    "test:ci": "tsc && rstest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint src/ scripts/",
    "lint:fix": "oxlint src/ scripts/ --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "dev:rspack": "pnpm build && pnpm --filter svg-sprite-consumer-demo dev",
    "dev:webpack": "pnpm --filter svg-sprite-webpack-demo dev",
    "prepublishOnly": "pnpm build",
    "prepare": "node scripts/hooks/install.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "knip": "knip",
    "check:package": "node scripts/ci/package-check.mjs"
  },
  "peerDependencies": {
    "@rsbuild/core": ">=1.0.0",
    "@rspack/core": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "@rspack/core": {
      "optional": true
    },
    "@rsbuild/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@rsbuild/core": "1.7.3",
    "@rspack/core": "^1.7.6",
    "@rstest/core": "0.12.6",
    "@rstest/coverage-istanbul": "0.12.6",
    "htmlparser2": "9.1.0",
    "knip": "6.45.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "rsbuild-v2": "npm:@rsbuild/core@2.3.2",
    "rspack-v2": "npm:@rspack/core@2.3.2",
    "svgo": "4.1.0",
    "svgo-loader": "5.0.0",
    "typescript": "7.0.2",
    "webpack": "5.105.2"
  },
  "packageManager": "pnpm@12.18.0"
}
