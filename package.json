{
  "name": "rspack-plugin-svg-sprite",
  "version": "1.6.4",
  "description": "SVG sprite loader and plugin for Rspack — drop-in replacement for svg-sprite-loader with inline and extract mode support",
  "author": "Yichen Zhu",
  "license": "MIT",
  "type": "commonjs",
  "homepage": "https://github.com/yichenzhu1337/rspack-plugin-svg-sprite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yichenzhu1337/rspack-plugin-svg-sprite.git"
  },
  "bugs": {
    "url": "https://github.com/yichenzhu1337/rspack-plugin-svg-sprite/issues"
  },
  "keywords": [
    "rspack",
    "rspack-plugin",
    "rspack-loader",
    "rsbuild",
    "rsbuild-plugin",
    "svg",
    "svg-sprite",
    "svg-sprite-loader",
    "svg-icon",
    "svg-icons",
    "sprite",
    "sprite-sheet",
    "icon",
    "icon-system",
    "loader",
    "plugin",
    "bundler-plugin",
    "webpack",
    "webpack5",
    "extract",
    "inline",
    "symbol",
    "react",
    "vue",
    "migration",
    "drop-in"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin.d.mts",
        "default": "./dist/plugin.mjs"
      },
      "default": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.js"
      }
    },
    "./loader": {
      "import": {
        "types": "./dist/loader.d.mts",
        "default": "./dist/loader.mjs"
      },
      "default": {
        "types": "./dist/loader.d.ts",
        "default": "./dist/loader.js"
      }
    },
    "./runtime/browser-sprite": {
      "import": {
        "types": "./dist/runtime/browser-sprite.d.mts",
        "default": "./dist/runtime/browser-sprite.mjs"
      },
      "default": {
        "types": "./dist/runtime/browser-sprite.d.ts",
        "default": "./dist/runtime/browser-sprite.js"
      }
    },
    "./runtime/symbol": {
      "import": {
        "types": "./dist/runtime/symbol.d.mts",
        "default": "./dist/runtime/symbol.mjs"
      },
      "default": {
        "types": "./dist/runtime/symbol.d.ts",
        "default": "./dist/runtime/symbol.js"
      }
    },
    "./rsbuild": {
      "import": {
        "types": "./dist/rsbuild.d.mts",
        "default": "./dist/rsbuild.mjs"
      },
      "default": {
        "types": "./dist/rsbuild.d.ts",
        "default": "./dist/rsbuild.js"
      }
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "plugin": [
        "./dist/plugin.d.ts"
      ],
      "loader": [
        "./dist/loader.d.ts"
      ],
      "runtime/browser-sprite": [
        "./dist/runtime/browser-sprite.d.ts"
      ],
      "runtime/symbol": [
        "./dist/runtime/symbol.d.ts"
      ],
      "rsbuild": [
        "./dist/rsbuild.d.ts"
      ],
      "client": [
        "./client.d.ts"
      ]
    }
  },
  "files": [
    "dist/",
    "client.d.ts",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && rstest run",
    "test:ci": "tsc && rstest run --coverage",
    "test:mutation": "bunx @stryker-mutator/core@10.1.1 run .config/stryker.config.mjs",
    "typecheck": "tsc --noEmit && tsc -p .config/tsconfig.test.json && tsc -p .config/tsconfig.scripts.json",
    "lint": "oxlint src/ scripts/",
    "lint:fix": "oxlint src/ scripts/ --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "dev:rspack": "bun run build && bun run --filter svg-sprite-consumer-demo dev",
    "dev:webpack": "bun run --filter svg-sprite-webpack-demo dev",
    "prepublishOnly": "bun run build",
    "prepare": "node scripts/hooks/install.mts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "bench": "bun run build && bun run --filter svg-sprite-bench bench",
    "knip": "bun run build && knip",
    "test:e2e": "bun run --filter rspack-plugin-svg-sprite-e2e test",
    "check:package": "node scripts/ci/package-check.mts"
  },
  "peerDependencies": {
    "@rsbuild/core": ">=1.0.0",
    "@rspack/core": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "@rspack/core": {
      "optional": true
    },
    "@rsbuild/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@rsbuild/core": "1.7.3",
    "@rspack/core": "^1.7.6",
    "@rstest/core": "0.12.6",
    "@rstest/coverage-istanbul": "0.12.6",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.4",
    "htmlparser2": "9.1.0",
    "knip": "6.45.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "rsbuild-v2": "npm:@rsbuild/core@2.3.2",
    "rspack-v2": "npm:@rspack/core@2.3.2",
    "svg-sprite-loader": "6.0.11",
    "svgo": "4.1.0",
    "svgo-loader": "5.0.0",
    "typescript": "7.0.2",
    "typescript-5.0": "npm:typescript@5.0.4",
    "typescript-5.2": "npm:typescript@5.2.2",
    "typescript-5.3": "npm:typescript@5.3.3",
    "typescript-5.9": "npm:typescript@5.9.3",
    "webpack": "5.105.2"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    ".",
    "examples/*",
    "e2e",
    "bench",
    "website"
  ],
  "trustedDependencies": [],
  "resolutions": {
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "@vue/server-renderer": "3.5.42",
    "body-parser": "1.20.9",
    "browserslist": "4.28.7",
    "compression": "1.8.2",
    "decode-uri-component": "0.5.1",
    "fast-uri": "3.1.9",
    "follow-redirects": "1.16.3",
    "http-proxy-middleware": "2.0.10",
    "launch-editor": "2.14.2",
    "lodash": "4.18.1",
    "nanoid": "3.3.18",
    "node-forge": "1.4.3",
    "path-to-regexp": "0.1.13",
    "postcss-selector-parser": "7.1.6",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "svgo-loader/svgo": "2.8.4",
    "tmp": "0.2.7",
    "websocket-driver": "0.7.5",
    "ws": "8.21.0",
    "webpack-dev-server": "5.2.6",
    "serialize-javascript": "7.1.4",
    "glob/minimatch": "3.1.5",
    "minimatch/brace-expansion": "1.1.22",
    "tinyglobby/picomatch": "4.0.7",
    "anymatch/picomatch": "2.3.2",
    "readdirp/picomatch": "2.3.2",
    "micromatch/picomatch": "2.3.2",
    "@changesets/git/picomatch": "2.3.2",
    "css-loader/postcss": "8.5.33",
    "@vue/compiler-sfc/postcss": "8.5.33",
    "basic-ftp": "6.2.4",
    "braces": "3.0.3"
  }
}
