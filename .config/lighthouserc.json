{
  "ci": {
    "collect": {
      "staticDistDir": "./_site",
      "url": ["/index.html", "/docs/index.html", "/docs/getting-started.html"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://[^/]+/index\\.html$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "errors-in-console": ["error", { "minScore": 1 }]
          }
        },
        {
          "matchingUrlPattern": "^http://[^/]+/docs/index\\.html$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "errors-in-console": ["error", { "minScore": 1 }]
          }
        },
        {
          "matchingUrlPattern": "^http://[^/]+/docs/getting-started\\.html$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.96 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "errors-in-console": ["error", { "minScore": 1 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
